# Keys for the end-to-end agent tests only (tests/e2e). The skill itself needs no keys.
# Copy to .env and fill in the one you use; .env is git-ignored.

# Google Gemini (https://aistudio.google.com/apikey) — free tier with rate limits
GEMINI_API_KEY=

# Claude API (https://console.anthropic.com/) — paid, ~$0.05 per test query on Haiku 4.5
ANTHROPIC_API_KEY=
